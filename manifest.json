{
  "manifest_version": 3,
  "name": "DogNerd",
  "version": "0.2.0",
  "description": "Extra information and UI improvements for Dog Online.",
  "homepage_url": "https://github.com/nyukuru/DogNerd",
  "icons": {
    "128": "img/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dognerd@nyukuru",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://dogonline.net/*", "https://raw.githubusercontent.com/nyukuru/DogNerd/*"],
  "web_accessible_resources": [
    {
      "resources": ["img/*", "data/*"],
      "matches": ["https://dogonline.net/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/accessibility.js"],
      "css": ["src/accessibility.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/inventory-early.js"],
      "css": ["src/inventory.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/common.js", "src/collection.js", "src/doghouse.js", "src/farm.js", "src/fishing.js", "src/inventory.js", "src/items.js", "src/maze.js", "src/newday.js", "src/settings.js", "src/tower.js", "src/trade.js", "src/tradeimage.js"],
      "css": ["src/collection.css", "src/doghouse.css", "src/farm.css", "src/fishing.css", "src/items.css", "src/maze.css", "src/newday.css", "src/settings.css", "src/tower.css", "src/trade.css"],
      "run_at": "document_idle"
    }
  ]
}
